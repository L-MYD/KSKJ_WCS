<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 生成XML文档，供 Swagger 注释使用；忽略缺失XML注释警告 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
    <!-- nan_T 2026-09-09：EF Core 迁移工具需要启动项目引用 Design 包 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 表现层同时依赖接口层与实现层，面向接口编程 -->
    <ProjectReference Include="..\WCS_IServices\WCS_IServices.csproj" />
    <ProjectReference Include="..\WCS_Helper\WCS_Helper.csproj" />
    <ProjectReference Include="..\WCS_Model\WCS_Model.csproj" />
    <ProjectReference Include="..\WCS_Services\WCS_Services.csproj" />
  </ItemGroup>

</Project>
